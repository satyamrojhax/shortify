{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/__viewer-country",
      "destination": "https://randomchat.now/__viewer-country"
    },
    {
      "source": "/api/webcams/(.*)",
      "destination": "https://viralxxxporn.com/api/webcams/$1"
    },
    {
      "source": "/api/shorts/(.*)",
      "destination": "https://viralxxxporn.com/api/shorts/$1"
    },
    {
      "source": "/api/shorts",
      "destination": "https://viralxxxporn.com/api/shorts/"
    },
    {
      "source": "/shortify/(.*)",
      "destination": "https://mcrhjyszrxbtiizhgacn.supabase.co/$1"
    },
    {
      "source": "/((?!api/|__viewer-country|shortify/|assets/|icons/|logo\\.png|PWA_ICON\\.png|manifest\\.json|favicon\\.|robots\\.txt|sitemap\\.).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Cloudflare-CDN-Cache-Control",
          "value": "max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/(.*)\\.(png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|eot)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=31536000"
        },
        {
          "key": "Cloudflare-CDN-Cache-Control",
          "value": "max-age=31536000"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, s-maxage=31536000, immutable"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=31536000"
        },
        {
          "key": "Cloudflare-CDN-Cache-Control",
          "value": "max-age=31536000"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "max-age=604800, stale-while-revalidate=86400"
        },
        {
          "key": "Cloudflare-CDN-Cache-Control",
          "value": "max-age=604800, stale-while-revalidate=86400"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
